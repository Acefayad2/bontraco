# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase Postgres. Session-mode pooler (port 5432) for a long-lived Node
# server; transaction mode (6543) if you move to serverless.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Direct connection, used by the migration script only.
DATABASE_URL_DIRECT="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key>"

# Optional. Without it the deterministic fallback analyzer runs instead, and
# both the contract record and the UI say which one produced the findings.
ANTHROPIC_API_KEY=""
